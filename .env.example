# Community Reporting System - Environment Configuration
# Copy this file to .env and fill in with your values

# ==================== Server Configuration ====================
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# ==================== Database Configuration ====================
# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=community_reporting_db

# MongoDB (for media/logs)
MONGO_URI=mongodb://localhost:27017/community_reporting
MONGODB_URI=mongodb://localhost:27017/community_reporting
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Redis (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== JWT Configuration ====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here

# ==================== Email Configuration ====================
# Using SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_not_regular_password
SMTP_FROM=noreply@communityreporting.app

# OR using SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@communityreporting.app

# ==================== SMS Configuration ====================
# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# Africa's Talking
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_USERNAME=your_africas_talking_username

# ==================== Push Notifications (FCM) ====================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ==================== AWS S3 Configuration ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=community-reporting-bucket

# ==================== Security Configuration ====================
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,https://yourdomain.com
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=1000
MAX_REPORTS_PER_USER=10

# ==================== Google Maps API ====================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ==================== Admin Configuration ====================
ADMIN_REGISTRATION_CODE=ADMIN2026

# ==================== Logging ====================
LOG_LEVEL=info
LOG_DIR=./logs

# ==================== Frontend URL ====================
FRONTEND_URL=http://localhost:3000
